# Ignore everything by default
*

# Except src (frontend source code)
!src/
!src/**

# Except data (calculated data, charts, exports)
!data/
!data/**

# Except build (pipeline manifests)
!build/
!build/**

# Except public (static assets)
!public/
!public/**

# Except versions (backups)
!versions/
!versions/**

# Except docs (documentation)
!docs/
!docs/**

# Except root index.html
!index.html

# Except .gitignore itself
!.gitignore

# Ignore unnecessary files
**/.DS_Store
**/*.zip
**/README.md

# Ignore other projects (all tracked pages should go through build/pipeline.py to src/)
projects/001-增长/
projects/002-内容/
projects/003-运营/
projects/004-工具/
