<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dinoisland.guild-report</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/TQP4000/Sync/Work/dino_pd/scripts/guild-report-launcher.sh</string>
    </array>

    <!-- 每小时整点执行（Minute=0，Hour 省略 = 每小时） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 标准输出/错误重定向到日志 -->
    <key>StandardOutPath</key>
    <string>/Volumes/TQP4000/Sync/Work/dino_pd/logs/launchd-guild-report.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/TQP4000/Sync/Work/dino_pd/logs/launchd-guild-report-error.log</string>
</dict>
</plist>
